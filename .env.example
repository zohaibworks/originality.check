# ── Server-side secrets (never expose as VITE_ variables) ──────────────────────

# Required: AI or Not API key for AI content detection
AIORNOT_API_KEY="SET_SERVER_SIDE_SECRET"

# Required on Cloud Run: set automatically via Workload Identity or service account
# For local dev: path to a Firebase Admin service account JSON key file
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"

# Optional: restrict CORS to additional origins beyond the built-in Vercel URL
# Comma-separated list, e.g. https://my-preview.vercel.app,https://custom.domain.com
FRONTEND_ORIGIN=""

# ── Frontend env vars (safe to expose, bundled by Vite) ────────────────────────

# The deployed Cloud Run backend URL — set this in Vercel project settings
# Leave empty when running locally (falls back to /api/* on the same server)
VITE_API_URL="https://YOUR_CLOUD_RUN_SERVICE-HASH-uc.a.run.app"
